{
    "name": "sierratecnologia/transmissor",
    "description": "Simple user messaging and notifications tool for Laravel",
    "type": "library",
    "keywords": [
        "sierratecnologia",
        "transmissor",
        "laravel",
        "messenger",
        "messaging",
        "user messaging"
    ],
    "license": "MIT",
    "homepage": "https://sierratecnologia.com/packages/transmissor/",
    "support": {
        "email": "help@sierratecnologia.com.br",
        "issues": "https://github.com/sierratecnologia/transmissor/issues",
        "source": "https://github.com/sierratecnologia/transmissor",
        "docs": "https://github.com/sierratecnologia/transmissor/blob/master/README.md"
    },
    "authors": [
        {
            "name": "SierraTecnologia",
            "homepage": "https://sierratecnologia.com.br",
            "email": "help@sierratecnologia.com.br"
        },
        {
            "name": "Ricardo Rebello Sierra",
            "email": "contato@ricardosierra.com.br"
        }
    ],
    "require": {
        "php": "^8.3",
        "illuminate/config": "^13.0",
        "illuminate/support": "^13.0",
        "illuminate/database": "^13.0",
        "sierratecnologia/muleta": "^2.0",
        "ramsey/uuid": "^4.9",
        "guzzlehttp/guzzle": "^7.10|^8.0",
        "cmgmyr/messenger": "^2.32"
    },
    "require-dev": {
        "barryvdh/laravel-debugbar": "^4.4",
        "barryvdh/laravel-ide-helper": "^3.7",
        "friendsofphp/php-cs-fixer": "^3.68",
        "nunomaduro/larastan": "^3.11",
        "orchestra/testbench": "^11.0",
        "phpstan/phpstan": "^2.2",
        "phpunit/phpunit": "^13.0",
        "sierratecnologia/crypto": "^2.0",
        "sierratecnologia/porteiro": "^2.0",
        "sierratecnologia/telefonica": "^2.0"
    },
    "suggest": {
        "sierratecnologia/crypto": "^2.0 - Optional encryption utilities",
        "sierratecnologia/integrations": "^2.0 - Third-party connectors",
        "sierratecnologia/porteiro": "^2.0 - User auth activity tracking",
        "sierratecnologia/population": "^2.0 - Entity population models",
        "sierratecnologia/locaravel": "^2.0 - Brazilian location models",
        "sierratecnologia/telefonica": "^2.0 - WhatsApp messaging provider",
        "resend/resend-php": "^1.15 - Required by Laravel's resend mailer (MAIL_MAILER=resend) for email alerts",
        "illuminate/config": "^5.5|^6.0|^7.0|^8.0",
        "illuminate/support": "^5.5|^6.0|^7.0|^8.0",
        "illuminate/database": "^5.5|^6.0|^7.0|^8.0",
        "fakerphp/faker": "^1.5"
    },
    "autoload": {
        "psr-4": {
            "Transmissor\\": "src/"
        },
        "files": [
            "helpers/activity_helper.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Transmissor\\Test\\": "tests/tests/",
            "Transmissor\\Tests\\": "tests/tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "test-coverage": "vendor/bin/phpunit --coverage-html build/coverage",
        "format": "vendor/bin/php-cs-fixer fix --allow-risky=yes",
        "format-dry": "vendor/bin/php-cs-fixer fix --allow-risky=yes --dry-run --diff",
        "analyse": [
            "@phpstan",
            "@psalm"
        ],
        "phpstan": "vendor/bin/phpstan analyse",
        "psalm": "vendor/bin/psalm",
        "check": [
            "@format-dry",
            "@analyse",
            "@test"
        ],
        "post-install-cmd": [],
        "post-update-cmd": [],
        "post-create-project-cmd": []
    },
    "repositories": [
        {
            "type": "path",
            "url": "../**",
            "options": {
                "symlink": true
            }
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "sort-packages": true
    },
    "extra": {
        "laravel": {
            "providers": [
                "Transmissor\\TransmissorProvider"
            ]
        }
    },
    "version": "2.2.0"
}
